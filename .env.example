# Google Apps Script Web App Deployment URL
APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbx.../exec"

# Shared Secret Token between Next.js server & Apps Script
APPS_SCRIPT_SECRET="your_secure_shared_secret_token_here"

# Next.js Authentication / Session Secret
AUTH_SECRET="your_jwt_session_secret_32_characters_min"

